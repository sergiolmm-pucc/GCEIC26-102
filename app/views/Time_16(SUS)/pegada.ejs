<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Pegada de carbono mensal</title>
  <link rel="stylesheet" href="/sus.css">
</head>
<body>
  <%- include('_nav', { ativo: 'pegada' }) %>

  <div class="container">
    <div class="card wide">
      <h1>📅 Pegada de carbono mensal</h1>
      <p>Soma transporte (vario tipos), energia eletrica residencial e alimentacao no mes.</p>

      <form method="POST" action="/sus/pegada">

        <h3 style="margin-top:14px;">Transporte (km no mes)</h3>

        <div class="linha-transporte">
          <label>Carro (gasolina)</label>
          <input type="number" name="km_carro_gasolina" min="0" step="0.1" value="0">
        </div>
        <div class="linha-transporte">
          <label>Onibus</label>
          <input type="number" name="km_onibus" min="0" step="0.1" value="0">
        </div>
        <div class="linha-transporte">
          <label>Metro / Trem</label>
          <input type="number" name="km_metro" min="0" step="0.1" value="0">
        </div>
        <div class="linha-transporte">
          <label>Moto</label>
          <input type="number" name="km_moto" min="0" step="0.1" value="0">
        </div>
        <div class="linha-transporte">
          <label>Aviao</label>
          <input type="number" name="km_aviao" min="0" step="0.1" value="0">
        </div>

        <h3 style="margin-top:18px;">Casa / dieta</h3>

        <label for="energiaKwh">Consumo de energia eletrica no mes (kWh)</label>
        <input id="energiaKwh" type="number" name="energiaKwh" min="0" step="0.1" value="0" required>

        <label for="pessoasCasa">Quantas pessoas moram na casa</label>
        <input id="pessoasCasa" type="number" name="pessoasCasa" min="1" step="1" value="1" required>

        <label for="dieta">Tipo de dieta</label>
        <select id="dieta" name="dieta" required>
          <option value="carnivora">Carnivora</option>
          <option value="mista" selected>Mista</option>
          <option value="vegetariana">Vegetariana</option>
          <option value="vegana">Vegana</option>
        </select>

        <button type="submit">Calcular pegada</button>
      </form>

      <% if (typeof resultado !== 'undefined' && resultado && resultado.success) { %>
        <div class="resultado">
          <h2>Sua pegada mensal</h2>
          <p><strong>Transporte:</strong> <%= resultado.data.transporte_kg %> kg CO2</p>
          <p><strong>Energia eletrica:</strong> <%= resultado.data.energia_kg %> kg CO2</p>
          <p><strong>Alimentacao (<%= resultado.data.dieta %>):</strong> <%= resultado.data.alimentacao_kg %> kg CO2</p>
          <hr style="margin:10px 0;border:none;border-top:1px solid #c8d7c8;">
          <p style="font-size:18px;"><strong>Total:</strong> <%= resultado.data.total_kg_co2 %> kg CO2 / mes</p>
          <p style="margin-top:10px;">
            <a class="btn btn-outline" href="/sus/arvores?kg=<%= resultado.data.total_kg_co2 %>">
              Compensar com arvores →
            </a>
          </p>
        </div>
      <% } else if (typeof resultado !== 'undefined' && resultado && !resultado.success) { %>
        <div class="error"><%= resultado.error %></div>
      <% } %>

    </div>
  </div>
</body>
</html>
