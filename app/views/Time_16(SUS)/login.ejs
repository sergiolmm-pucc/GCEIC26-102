<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Login - SUS</title>
  <link rel="stylesheet" href="/sus.css">
</head>
<body class="center">
  <div class="card">
    <h1>Entrar</h1>
    <form method="POST" action="/sus/login">
      <label for="usuario">Usuario</label>
      <input id="usuario" type="text" name="usuario" placeholder="admin" required>

      <label for="senha">Senha</label>
      <input id="senha" type="password" name="senha" placeholder="admin" required>

      <button type="submit">Entrar</button>
    </form>
    <% if (erro) { %>
      <div class="error"><%= erro %></div>
    <% } %>
    <p style="margin-top:14px;text-align:center;font-size:13px;color:#6b806b;">
      dica: usuario <b>admin</b> / senha <b>admin</b>
    </p>
  </div>
</body>
</html>
