<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Emissao por transporte</title>
  <link rel="stylesheet" href="/sus.css">
</head>
<body>
  <%- include('_nav', { ativo: 'transporte' }) %>

  <div class="container">
    <div class="card wide">
      <h1>🚗 Emissao de CO2 por transporte</h1>
      <p>Informe o tipo de transporte e a distancia. A gente calcula quanto CO2 foi pra atmosfera.</p>

      <form method="POST" action="/sus/transporte">

        <label for="transporte">Tipo de transporte</label>
        <select id="transporte" name="transporte" required>
          <option value="carro_gasolina">Carro - gasolina</option>
          <option value="carro_etanol">Carro - etanol</option>
          <option value="carro_diesel">Carro - diesel</option>
          <option value="moto">Moto</option>
          <option value="onibus">Onibus</option>
          <option value="metro">Metro / Trem</option>
          <option value="bicicleta">Bicicleta</option>
          <option value="a_pe">A pe</option>
          <option value="aviao">Aviao</option>
        </select>

        <label for="km">Distancia percorrida (km)</label>
        <input id="km" type="number" name="km" min="0" step="0.1" placeholder="ex: 15" required>

        <button type="submit">Calcular</button>
      </form>

      <% if (typeof resultado !== 'undefined' && resultado && resultado.success) { %>
        <div class="resultado">
          <h2>Resultado</h2>
          <p><strong>Transporte:</strong> <%= resultado.data.transporte %></p>
          <p><strong>Distancia:</strong> <%= resultado.data.km %> km</p>
          <p><strong>Emissao:</strong> <%= resultado.data.emissao_kg_co2 %> kg de CO2</p>
        </div>
        <div class="dica">
          💡 Dica: a mesma distancia de bicicleta ou a pe gera <b>zero</b> emissao!
        </div>
      <% } else if (typeof resultado !== 'undefined' && resultado && !resultado.success) { %>
        <div class="error"><%= resultado.error %></div>
      <% } %>

    </div>
  </div>
</body>
</html>
