<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FLP — Sobre</title>
  <link rel="stylesheet" href="/flp.css">
  <style>
    .ab-layout {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 24px;
      align-items: start;
    }
    @media (max-width: 760px) { .ab-layout { grid-template-columns: 1fr; } }

    .ab-identity {
      background: var(--sidebar-bg);
      background-image: radial-gradient(ellipse at bottom left, rgba(58,158,67,0.18) 0%, transparent 60%);
      border-radius: var(--radius-lg);
      padding: 32px 24px;
      color: #fff;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .about-logo {
      font-size: 56px;
      font-weight: 900;
      letter-spacing: -2px;
      color: var(--accent-light);
      line-height: 1;
    }

    .ab-project-name {
      font-size: 14px;
      color: rgba(255,255,255,0.5);
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-top: 6px;
      font-weight: 400;
    }

    .ab-divider {
      height: 1px;
      background: rgba(255,255,255,0.1);
      margin: 20px 0;
    }

    .ab-desc {
      font-size: 13px;
      color: rgba(255,255,255,0.55);
      line-height: 1.8;
      margin-bottom: 20px;
    }

    .ab-meta-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .ab-meta-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .ab-meta-label {
      font-size: 10px;
      color: rgba(255,255,255,0.3);
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 700;
    }

    .ab-meta-value {
      font-size: 13px;
      color: rgba(255,255,255,0.8);
      font-weight: 500;
    }

    .ab-right {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .ab-section-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .ab-section-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .ab-photo-area {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .ab-team-cards {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      margin-top: 16px;
      width: 100%;
    }

    .team-member {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 12px;
      text-align: center;
      transition: border-color 0.15s, transform 0.15s;
    }
    .team-member:hover { border-color: var(--accent); transform: translateY(-2px); }

    .team-member-avatar {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--sidebar-bg), var(--accent));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      font-weight: 700;
      color: #fff;
      margin: 0 auto 10px;
    }

    .team-member-name { font-size: 13px; font-weight: 700; color: var(--text); }
    .team-member-role { font-size: 11px; color: var(--text-secondary); margin-top: 3px; }

    .ab-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 4px;
    }

    .ab-tag {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 4px 12px;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-secondary);
    }
    .ab-tag.green { background: #ECFDF5; border-color: #A7F3D0; color: var(--accent-dark); }
  </style>
</head>
<body>
  <div class="layout">
    <%- include('nav') %>
    <main class="page-content">

      <div class="ab-layout">

        <!-- Coluna esquerda: identidade do projeto -->
        <aside class="ab-identity">
          <div class="about-logo">FLP</div>
          <div class="ab-project-name">Folha de Pagamento</div>
          <div class="ab-divider"></div>
          <p class="ab-desc">
            Sistema acadêmico para cálculo automatizado da folha de pagamento —
            INSS progressivo, IRRF, FGTS, horas extras e deduções por dependentes.
          </p>
          <div class="ab-meta-list">
            <div class="ab-meta-item">
              <span class="ab-meta-label">Instituição</span>
              <span class="ab-meta-value">Escola Politécnica — PUC Campinas</span>
            </div>
            <div class="ab-meta-item">
              <span class="ab-meta-label">Disciplina</span>
              <span class="ab-meta-value">Gerência de Configuração, Entrega e IC</span>
            </div>
            <div class="ab-meta-item">
              <span class="ab-meta-label">Período</span>
              <span class="ab-meta-value">1º Semestre 2026</span>
            </div>
            <div class="ab-meta-item">
              <span class="ab-meta-label">Tema</span>
              <span class="ab-meta-value">INSS · IRRF · FGTS · Horas Extras</span>
            </div>
            <div class="ab-meta-item">
              <span class="ab-meta-label">CI/CD</span>
              <span class="ab-meta-value">GitHub Actions</span>
            </div>
          </div>
          <div class="ab-divider"></div>
          <div style="margin-bottom:8px">
            <span class="ab-meta-label" style="display:block;margin-bottom:8px">Tecnologias</span>
            <div class="ab-stack">
              <span class="ab-tag green">Node.js</span>
              <span class="ab-tag green">Express</span>
              <span class="ab-tag green">EJS</span>
              <span class="ab-tag green">Jest</span>
              <span class="ab-tag">Selenium</span>
              <span class="ab-tag">GitHub Actions</span>
            </div>
          </div>
        </aside>

        <!-- Coluna direita: equipe -->
        <div class="ab-right">

          <div class="ab-photo-area">
            <div class="ab-section-title" style="width:100%">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Nossa Equipe
            </div>

            <img
              class="team-photo-img"
              src="/teamFLP.jpg"
              alt="Equipe FLP"
              id="teamPhoto"
              onerror="this.style.display='none';document.getElementById('teamPlaceholder').style.display='flex'"
              style="width:100%;max-width:480px;border-radius:var(--radius);object-fit:cover;border:2px solid var(--accent);display:block"
            >
            <div id="teamPlaceholder"
              style="display:none;width:100%;aspect-ratio:16/7;background:var(--bg);border:2px dashed var(--border);border-radius:var(--radius);flex-direction:column;align-items:center;justify-content:center;gap:8px;color:var(--text-secondary);font-size:13px">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--border)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
              Foto da equipe
            </div>

            <div class="ab-team-cards">
              <div class="team-member">
                <div class="team-member-avatar">GP</div>
                <div class="team-member-name">Guilherme G. Piovezan</div>
                <div class="team-member-role">Desenvolvedor</div>
              </div>
              <div class="team-member">
                <div class="team-member-avatar">RL</div>
                <div class="team-member-name">Renan M. Lother</div>
                <div class="team-member-role">Desenvolvedor</div>
              </div>
              <div class="team-member">
                <div class="team-member-avatar">TG</div>
                <div class="team-member-name">Talitha B. Gentil</div>
                <div class="team-member-role">Desenvolvedora</div>
              </div>
            </div>
          </div>

        </div>
      </div>

    </main>
  </div>
</body>
</html>
