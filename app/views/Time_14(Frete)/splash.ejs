<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>FastFrete | Splash</title>

  <link rel="stylesheet" href="/Time_14(Frete)/css/app.css" />

  <script>
    setTimeout(() => {
      window.location.href = "/frete/login";
    }, 2500);
  </script>
</head>
<body>
  <main class="splash-shell">
    <section class="splash-grid">
      <article class="splash-panel panel panel-strong pad-xl stack-lg">
        <div class="brand-mark">🚚</div>
        <div class="stack-md">
          <p class="eyebrow">Time 14</p>
          <h1 class="splash-wordmark">FastFrete</h1>
          <p class="panel-copy">
            Sistema de cálculo de frete, cotação e composição transparente de taxas.
          </p>
        </div>

        <div class="kicker-row">
          <span class="kicker-tag">Entrada rápida</span>
          <span class="kicker-tag">Cálculo completo</span>
          <span class="kicker-tag">Resultado claro</span>
        </div>
      </article>

      <article class="splash-panel panel panel-accent panel-raised pad-xl stack-lg">
        <div class="display-box">→</div>
        <div class="stack-sm">
          <p class="eyebrow">Inicializando</p>
          <h2 class="panel-title">Carregando aplicação...</h2>
          <p class="panel-copy">Você será redirecionado automaticamente para o login.</p>
        </div>

        <div class="loading-track">
          <div class="loading-progress"></div>
        </div>
      </article>
    </section>
  </main>
</body>
</html>