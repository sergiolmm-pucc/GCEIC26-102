<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>FastFrete | Calcular Frete</title>

  <link rel="stylesheet" href="/Time_14(Frete)/css/base.css" />
  <link rel="stylesheet" href="/Time_14(Frete)/css/calcular.css" />
</head>
<body class="app-page">
  <header class="app-header">
    <div class="brand-area">
      <div class="brand-icon">🚚</div>
      <div>
        <h1>FastFrete</h1>
        <p>Sistema de cálculo de frete</p>
      </div>
    </div>

    <nav class="app-nav">
      <a href="/frete/home" class="nav-link">Home</a>
      <a href="/frete/calcular" class="nav-link active">Calcular</a>
      <a href="/frete/about" class="nav-link">Sobre</a>
      <a href="/frete/help" class="nav-link">Help</a>
      <a href="/frete/logout" class="nav-link logout">Sair</a>
    </nav>
  </header>

  <main class="calcular-main">
    <section class="calcular-hero">
      <div>
        <p class="page-label">Cotação de frete</p>
        <h2>Calcule o valor final do frete</h2>
        <p>
          Informe os dados da encomenda para calcular peso cubado, peso faturado,
          valor base, taxa de importação, seguro e valor final.
        </p>
      </div>
    </section>

    <section class="calcular-layout">
      <article class="form-card">
        <h3>Dados da encomenda</h3>

        <% if (error) { %>
          <div class="alert-error">
            <%= error %>
          </div>
        <% } %>

        <form id="freteForm" class="frete-form">
          <div class="form-grid">
            <div class="form-group">
              <label for="comprimento">Comprimento (cm)</label>
              <input type="number" id="comprimento" name="comprimento" step="0.01" min="0" required />
            </div>

            <div class="form-group">
              <label for="largura">Largura (cm)</label>
              <input type="number" id="largura" name="largura" step="0.01" min="0" required />
            </div>

            <div class="form-group">
              <label for="altura">Altura (cm)</label>
              <input type="number" id="altura" name="altura" step="0.01" min="0" required />
            </div>

            <div class="form-group">
              <label for="pesoReal">Peso real (kg)</label>
              <input type="number" id="pesoReal" name="pesoReal" step="0.01" min="0" required />
            </div>

            <div class="form-group">
              <label for="distanciaKm">Distância (km)</label>
              <input type="number" id="distanciaKm" name="distanciaKm" step="0.01" min="0" required />
            </div>

            <div class="form-group">
              <label for="valorDeclarado">Valor declarado (R$)</label>
              <input type="number" id="valorDeclarado" name="valorDeclarado" step="0.01" min="0" required />
            </div>

            <div class="form-group form-group-full">
              <label for="tipoFrete">Tipo de frete</label>
              <select id="tipoFrete" name="tipoFrete" required>
                <option value="">Selecione uma opção</option>

                <% tiposFrete.forEach((item) => { %>
                  <option value="<%= item.tipo %>">
                    <%= item.tipo.charAt(0).toUpperCase() + item.tipo.slice(1) %>
                    - <%= item.aliquotaPercentual %>
                  </option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="checkbox-area">
            <label class="checkbox-card">
              <input type="checkbox" id="importado" name="importado" />
              <span>
                <strong>Produto importado</strong>
                <small>Aplica taxa de importação sobre o valor declarado.</small>
              </span>
            </label>

            <label class="checkbox-card">
              <input type="checkbox" id="segurado" name="segurado" />
              <span>
                <strong>Adicionar seguro</strong>
                <small>Aplica taxa de seguro sobre o valor declarado.</small>
              </span>
            </label>
          </div>

          <button type="submit" class="calculate-button form-submit-button">
            Calcular frete
          </button>
        </form>
      </article>

      <aside class="result-card">
        <h3>Resultado da cotação</h3>

        <div id="emptyState" class="empty-state">
          <div>📦</div>
          <p>Preencha o formulário para visualizar o resultado do cálculo.</p>
        </div>

        <div id="loadingState" class="loading-state hidden">
          Calculando frete...
        </div>

        <div id="errorState" class="result-error hidden"></div>

        <div id="resultState" class="result-state hidden">
          <div class="result-row">
            <span>Peso cubado</span>
            <strong id="pesoCubado">-</strong>
          </div>

          <div class="result-row">
            <span>Peso faturado</span>
            <strong id="pesoFaturado">-</strong>
          </div>

          <div class="result-row">
            <span>Valor base</span>
            <strong id="valorBase">-</strong>
          </div>

          <div class="result-row">
            <span>Taxa de importação</span>
            <strong id="taxaImportacao">-</strong>
          </div>

          <div class="result-row">
            <span>Taxa de seguro</span>
            <strong id="taxaSeguro">-</strong>
          </div>

          <div class="result-total">
            <span>Valor final</span>
            <strong id="valorFinal">-</strong>
          </div>
        </div>
      </aside>
    </section>
  </main>

  <script>
    const form = document.getElementById("freteForm");

    const emptyState = document.getElementById("emptyState");
    const loadingState = document.getElementById("loadingState");
    const errorState = document.getElementById("errorState");
    const resultState = document.getElementById("resultState");

    function formatarMoeda(valor) {
      return Number(valor).toLocaleString("pt-BR", {
        style: "currency",
        currency: "BRL"
      });
    }

    function mostrarCarregando() {
      emptyState.classList.add("hidden");
      errorState.classList.add("hidden");
      resultState.classList.add("hidden");
      loadingState.classList.remove("hidden");
    }

    function mostrarErro(mensagem) {
      loadingState.classList.add("hidden");
      resultState.classList.add("hidden");
      emptyState.classList.add("hidden");

      errorState.textContent = mensagem;
      errorState.classList.remove("hidden");
    }

    function mostrarResultado(data) {
      loadingState.classList.add("hidden");
      errorState.classList.add("hidden");
      emptyState.classList.add("hidden");
      resultState.classList.remove("hidden");

      document.getElementById("pesoCubado").textContent = `${data.pesoCubado} kg`;
      document.getElementById("pesoFaturado").textContent = `${data.pesoFaturado} kg`;
      document.getElementById("valorBase").textContent = formatarMoeda(data.valorBase);
      document.getElementById("taxaImportacao").textContent = formatarMoeda(data.taxaImportacao);
      document.getElementById("taxaSeguro").textContent = formatarMoeda(data.taxaSeguro);
      document.getElementById("valorFinal").textContent = formatarMoeda(data.valorFinal);
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      mostrarCarregando();

      const dados = {
        comprimento: Number.parseFloat(form.comprimento.value),
        largura: Number.parseFloat(form.largura.value),
        altura: Number.parseFloat(form.altura.value),
        pesoReal: Number.parseFloat(form.pesoReal.value),
        distanciaKm: Number.parseFloat(form.distanciaKm.value),
        tipoFrete: form.tipoFrete.value,
        valorDeclarado: Number.parseFloat(form.valorDeclarado.value),
        importado: form.importado.checked,
        segurado: form.segurado.checked
      };

      try {
        const response = await fetch("/frete/calcular", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify(dados)
        });

        const resultado = await response.json();

        if (!resultado.success) {
          mostrarErro(resultado.error || "Erro ao calcular o frete.");
          return;
        }

        mostrarResultado(resultado.data);
      } catch (err) {
        mostrarErro("Não foi possível conectar ao servidor do app.");
      }
    });
  </script>
</body>
</html>